{
  "name": "Syntheniq",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storageInGb": 32
  },
  "forwardPorts": [8787],
  "postCreateCommand": "bash scripts/start-codespaces.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["apps/api/src/server.ts", "apps/web/studio/api.ts"]
    }
  },
  "remoteUser": "node"
}
