{
  "name": "Syntheniq",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storageInGb": 32
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Syntheniq — open in browser",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash scripts/start-codespaces.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["apps/api/src/server.ts", "apps/web/studio/api.ts"]
    }
  },
  "remoteUser": "node"
}
