# ── Syntheniq — private workstation config ─────────────────────────────
# Copy to .env (or set as real environment variables). Keys are server-side
# only and are never sent to the browser.

# ── AI providers ────────────────────────────────────────────────────────
# Primary provider: openai | gemini | grok
# Leave blank to auto-pick the first configured provider (order: gemini, openai, grok).
AI_PROVIDER=
# Model for the primary provider. Blank = per-provider smart defaults per task.
AI_MODEL=
# Comma-separated fallback chain, tried in order when the primary fails
# (missing key, auth error, model unknown, network failure).
AI_FALLBACK=
# Per-task overrides. Tasks: ANALYZE  PLAN  PACKAGE  QC  VIDEO
# AI_TASK_ANALYZE_PROVIDER=
# AI_TASK_ANALYZE_MODEL=
# AI_TASK_PLAN_PROVIDER=
# AI_TASK_PLAN_MODEL=
# AI_TASK_PACKAGE_PROVIDER=
# AI_TASK_PACKAGE_MODEL=
# AI_TASK_QC_PROVIDER=
# AI_TASK_QC_MODEL=
# AI_TASK_VIDEO_PROVIDER=
# AI_TASK_VIDEO_MODEL=
# Second-pass review: a separate model critiques the edit plan before render.
# REVIEW_PROVIDER=
# REVIEW_MODEL=

# Provider keys (use whichever you have; at least one enables full AI mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ── Transcription ───────────────────────────────────────────────────────
# Engine: local (default, private, no key) | gemini (Gemini 3.5 Transcribe,
# needs GEMINI_API_KEY; automatically falls back to local on failure)
SYNTHENIQ_TRANSCRIBE=local
# Local faster-whisper model: tiny small medium large-v3
SYNTHENIQ_WHISPER_MODEL=small

# ── App ─────────────────────────────────────────────────────────────────
PORT=8787
SYNTHENIQ_DATA=./data
# Single passcode gate for the private UI (blank = no gate)
SYNTHENIQ_PASSWORD=
# Public origin baked into the web build (only needed when web is hosted
# separately from the API). Blank = same-origin (default, recommended).
NEXT_PUBLIC_API_URL=
