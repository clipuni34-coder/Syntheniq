# Syntheniq environment — copy to .env and fill in what you have.
# The app works with ANY subset: it auto-picks a working AI provider and
# fails down the chain; with no keys at all it runs in heuristic (offline) mode.

# ── access ────────────────────────────────────────────────────────────────
SYNTHENIQ_PASSWORD=syntheniq-2026
SYNTHENIQ_PORT=8787
# NEXT_PUBLIC_API_URL: only when reverse-proxying at a URL without the
# :8787 port (e.g. https://syntheniq.example.com). Blank for port access.
# Requires a rebuild: docker compose up -d --build
NEXT_PUBLIC_API_URL=

# ── AI providers (server-side only — never shipped to the browser) ────────
# Provide at least one key for AI-powered analysis/planning.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# AI_PROVIDER: empty = auto-pick the first configured provider.
#   openai | gemini | grok
AI_PROVIDER=
# AI_MODEL: optional. Must belong to AI_PROVIDER's family (gpt-* / gemini-* / grok-*);
# a mismatched model is ignored and the provider's own default is used.
AI_MODEL=
# AI_FALLBACK: comma-separated fallback chain after AI_PROVIDER (e.g. gemini,openai).
AI_FALLBACK=

# ── local transcription model (faster-whisper) ─────────────────────────────
# 'small' is baked into the image; other sizes download on first use.
# tiny | base | small | medium | large-v3   (small = good speed/quality tradeoff)
SYNTHENIQ_WHISPER_MODEL=small
