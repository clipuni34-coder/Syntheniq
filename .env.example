# Syntheniq — environment configuration. Copy to .env and fill in.
# NEVER commit real secrets. Every secret is read from the environment.

# --- API (@syntheniq/api) ---
PORT=8787
SYNTHENIQ_DATA=./apps/api/data
MAX_UPLOAD_MB=2048

# Transcription (best available wins; all optional):
# 1. OpenAI Whisper API (highest quality, needs key)
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1
# Compatible gateways (Azure OpenAI, proxies): override the API root.
OPENAI_BASE_URL=https://api.openai.com/v1
# 2. Local faster-whisper (default; needs python3 + faster_whisper)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
# 3. Audio-structure fallback (always available, no words)

# LLM editorial pass (structured scores + evidence for top candidates).
# Without OPENAI_API_KEY the deterministic heuristic ranking stands.
OPENAI_EDITORIAL_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
LLM_TOP_K=40

CLIPS_DEFAULT=5
CLIPS_MAX=8

# Persistence: unset = JSON document (dev/test only).
# Production (NODE_ENV=production) REQUIRES Postgres here.
DATABASE_URL=

# Storage: "local" (default, dev only) or "r2" (Cloudflare R2, required in
# production). R2_* are required when STORAGE_DRIVER=r2.
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRES=3600
# Set to 1 for path-style S3 endpoints (MinIO, moto, some gateways).
S3_FORCE_PATH_STYLE=

# Workers: jobs are persistent with leases, so any number of workers is safe.
# The API embeds a worker unless API_ONLY=1 (then run node dist/worker.js).
API_ONLY=
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1000
JOB_LEASE_SEC=30
JOB_MAX_ATTEMPTS=3

# CORS origin for the studio when hosted separately (default: allow all local).
WEB_ORIGIN=

# --- Web (@syntheniq/web) ---
# Where the studio reaches the API. Baked in at build time. Leave empty for
# same-origin (API serving the built app) or local default http://localhost:8787.
NEXT_PUBLIC_API_URL=
