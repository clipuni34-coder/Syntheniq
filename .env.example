# Syntheniq — environment configuration. Copy to .env and fill in.
# NEVER commit real secrets. Every secret is read from the environment.

# --- API (@syntheniq/api) ---
PORT=8787
SYNTHENIQ_DATA=./apps/api/data
MAX_UPLOAD_MB=2048

# Transcription (best available wins; all optional):
# 1. OpenAI Whisper API (highest quality, needs key)
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1
# 2. Local faster-whisper (default; needs python3 + faster_whisper)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
# 3. Audio-structure fallback (always available, no words)

CLIPS_DEFAULT=5
CLIPS_MAX=8

# Storage: "local" (default) or "r2" (Cloudflare R2; also needs the optional
# @aws-sdk/client-s3 package in apps/api).
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# CORS origin for the studio when hosted separately (default: allow all local).
WEB_ORIGIN=

# --- Web (@syntheniq/web) ---
# Where the studio reaches the API. Baked in at build time. Leave empty for
# same-origin (API serving the built app) or local default http://localhost:8787.
NEXT_PUBLIC_API_URL=
