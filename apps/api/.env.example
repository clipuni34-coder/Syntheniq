# Syntheniq API — Environment Configuration
# Copy this file to .env.local and fill in your values.
# Every setting is also configurable via real environment variables.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8788
MAX_UPLOAD_MB=2048
# Where project data (uploads, work files, exports) is stored.
# Use a dedicated path in production. Defaults to ./apps/api/data
SYNTHENIQ_DATA=/workspace/app/apps/api/data

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# OpenAI Whisper API (primary) — leave empty to use local faster-whisper only.
OPENAI_API_KEY=

# Local faster-whisper (fallback, works without network)
# Model options: tiny, tiny-dist, tiny-conv, base, base-dist, small, medium, large-v1
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu

# ---------------------------------------------------------------------------
# LLM Editorial (OpenAI Responses API used for clip ranking)
# ---------------------------------------------------------------------------
# Leave empty to use heuristic fallback (no API key needed).
OPENAI_EDITORIAL_KEY=
OPENAI_EDITORIAL_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# yt-dlp / YouTube import
# ---------------------------------------------------------------------------
# Path to browser cookies file (Firefox/Chrome format) for YouTube auth.
# Required if YouTube blocks the import (bot detection).
YTDLP_COOKIES=
# yt-dlp binary: 'python3' uses the pip-installed module, or full path to binary.
YTDLP_BINARY=python3
# Module name when using python3: 'yt_dlp' or 'ytdlp'
YTDLP_MODULE=yt_dlp

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# 'local' for filesystem storage, or leave empty for R2.
STORAGE_DRIVER=local

# Cloudflare R2 (production) — only needed when STORAGE_DRIVER is not 'local'.
# Run `npx wrangler secret put` to set these in Cloudflare, or export them locally.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Database (production — Postgres required; local uses JSON file store)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Worker configuration
# ---------------------------------------------------------------------------
# Number of concurrent transcription/render jobs.
WORKER_CONCURRENCY=1
# Polling interval for background jobs (ms).
WORKER_POLL_MS=1000
# How long to lease a job before it can be re-attempted (seconds).
JOB_LEASE_SEC=30
# Maximum retry attempts for a failed job.
JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Web frontend
# ---------------------------------------------------------------------------
# Where the built web app static export lives (served by the API at /).
WEB_OUT_DIR=/workspace/app/apps/web/out
# Origin URL for client-side fetch when proxying (leave empty for same-origin).
WEB_ORIGIN=
