 33.97, "end": 34.41, "word": "text,"}, {"start": 34.83, "end": 35.07, "word": "two"}, {"start": 35.07, "end": 35.23, "word": "or"}, {"start": 35.23, "end": 35.47, "word": "three"}, {"start": 35.47, "end": 35.79, "word": "words"}, {"start": 35.79, "end": 35.93, "word": "at"}, {"start": 35.93, "end": 36.01, "word": "a"}, {"start": 36.01, "end": 36.41, "word": "time,"}, {"start": 36.71, "end": 36.85, "word": "and"}, {"start": 36.85, "end": 37.23, "word": "highlight"}, {"start": 37.23, "end": 37.45, "word": "the"}, {"start": 37.45, "end": 37.73, "word": "important"}, {"start": 37.73, "end": 38.19, "word": "words."}]}, {"start": 38.57, "end": 40.89, "text": "People watch with a sound off all the time.", "words": [{"start": 38.57, "end": 38.81, "word": "People"}, {"start": 38.81, "end": 39.13, "word": "watch"}, {"start": 39.13, "end": 39.33, "word": "with"}, {"start": 39.33, "end": 39.45, "word": "a"}, {"start": 39.45, "end": 39.67, "word": "sound"}, {"start": 39.67, "end": 40.03, "word": "off"}, {"start": 40.03, "end": 40.41, "word": "all"}, {"start": 40.41, "end": 40.57, "word": "the"}, {"start": 40.57, "end": 40.89, "word": "time."}]}, {"start": 43.04, "end": 47.13, "text": "If you fix just those two things, your retention will change completely.", "words": [{"start": 43.04, "end": 43.16, "word": "If"}, {"start": 43.16, "end": 43.26, "word": "you"}, {"start": 43.26, "end": 43.44, "word": "fix"}, {"start": 43.44, "end": 43.8, "word": "just"}, {"start": 43.8, "end": 44.04, "word": "those"}, {"start": 44.04, "end": 44.3, "word": "two"}, {"start": 44.3, "end": 44.72, "word": "things,"}, {"start": 45.37, "end": 45.51, "word": "your"}, {"start": 45.51, "end": 45.89, "word": "retention"}, {"start": 45.89, "end": 46.17, "word": "will"}, {"start": 46.17, "end": 46.53, "word": "change"}, {"start": 46.53, "end": 47.13, "word": "completely."}]}, {"start": 47.47, "end": 49.85, "text": "Try it for one week, and come back and thank me.", "words": [{"start": 47.47, "end": 47.65, "wor