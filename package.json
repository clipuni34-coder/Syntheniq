{
  "name": "syntheniq",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @syntheniq/web run dev",
    "dev:api": "npm --workspace @syntheniq/api run dev",
    "build:web": "npm --workspace @syntheniq/web run build",
    "build:api": "npm --workspace @syntheniq/api run build",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/api/dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
