{
  "name": "syntheniq",
  "version": "0.1.0",
  "private": true,
  "description": "Syntheniq — AI video editing platform: long video in, story-driven vertical shorts out.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @syntheniq/api run dev",
    "dev:web": "npm --workspace @syntheniq/web run dev",
    "build:api": "npm --workspace @syntheniq/api run build",
    "build:web": "npm --workspace @syntheniq/web run build",
    "start:api": "npm --workspace @syntheniq/api run start",
    "test": "npm --workspace @syntheniq/api run test",
    "fixtures": "npm --workspace @syntheniq/api run fixtures"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
